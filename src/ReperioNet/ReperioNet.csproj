<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReperioNet</RootNamespace>
    <Description>Embedded, fuzzy, multilingual full-text search for .NET on SQLite FTS5 — typo-tolerant, substring, stemming and phonetic search with no server and no native build steps.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- AOT/trimming is a hard requirement (PRD §2): enable the trim/AOT/single-file analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Pinned explicitly, for two reasons:
         - The bundle that Microsoft.Data.Sqlite pulls in transitively can ship an SQLite below the
           3.43.0 minimum the PRD requires (contentless_delete=1).
         - Bundles up to 2.1.11 carry a vulnerable SQLite (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReperioNet.Tests" />
  </ItemGroup>

</Project>
