<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReperioNet.LanguageDetection</RootNamespace>
    <Description>Automatic language detection for ReperioNet backed by NTextCat (bundled Core14 profile).</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NTextCat is an unannotated netstandard2.0 dependency, but the full detection path was
         verified empirically: PublishTrimmed and PublishAot (linux-x64) both complete with zero
         IL warnings and the trimmed/native binary detects correctly. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NTextCat" Version="0.3.65" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReperioNet\ReperioNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored from the NTextCat 0.3.65 nupkg (MIT): the package ships the profile only under
         the legacy content/ folder, which does not flow to PackageReference consumers. Packed as
         contentFiles with copy-to-output so NuGet consumers get it next to their binaries too. -->
    <None Include="LanguageModels\Core14.profile.xml"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="contentFiles\any\any\LanguageModels"
          PackageCopyToOutput="true" />
  </ItemGroup>

</Project>
